# Wake word spike (Kconfig HG_WAKEWORD_SPIKE): the console's `wake` listens for
# "Hey Hermes" with ESP-SR WakeNet10. Not a release build.
CONFIG_HG_WAKEWORD_SPIKE=y
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_WN_WN10_HEYHERMES=y
CONFIG_SR_MN_CN_NONE=y
CONFIG_SR_MN_EN_NONE=y
# ESP-SR packs its models only when the partition table has a `model` partition.
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-wakeword.csv"
